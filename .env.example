# ==============================================================================
# RateMyPic Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Telegram Bot API Token (from @BotFather)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ_example

# PostgreSQL Database Connection URL
# Asynchronous driver postgresql+asyncpg is automatically selected.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ratemypic

# Telegram ID of the administrator (enables /stats admin dashboard & alerts)
ADMIN_ID=1954359757

# Optional: Application Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: Database Connection Pool Tuning
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=20
